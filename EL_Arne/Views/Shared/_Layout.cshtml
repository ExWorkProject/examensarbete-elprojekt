@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string NavLinkClass(string action)
    {
        var baseClass = "rounded px-3 py-2 text-sm font-medium transition hover:bg-slate-100 hover:text-slate-950";
        return currentAction == action
            ? $"{baseClass} bg-amber-100 text-slate-950"
            : $"{baseClass} text-slate-700";
    }
}
<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description"
          content="EL Arne erbjuder trygga elinstallationer, service och felsökning för hem, bostadsrättsföreningar och företag i Västra Götaland." />
    <meta name="theme-color" content="#f59e0b" />
    <title>@ViewData["Title"] | Andersson Projekt</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
</head>

<body class="bg-slate-50 text-slate-900 antialiased">
    <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8"
             aria-label="Huvudmeny">
            <a class="flex items-center gap-3" asp-controller="Home" asp-action="Index" aria-label="EL Arne startsida">
                <span class="grid h-10 w-10 place-items-center rounded bg-amber-400 font-black text-slate-950">AP</span>
                <span>
                    <span class="block text-base font-bold leading-tight">Andersson Projekt</span>
                    <span class="block text-xs text-slate-500">El i Spannarboda</span>
                </span>
            </a>

            <button id="mobile-menu-button"
                    class="inline-flex h-10 w-10 items-center justify-center rounded border border-slate-200 text-slate-700 md:hidden"
                    type="button" aria-controls="mobile-menu" aria-expanded="false">
                <span class="sr-only">Öppna meny</span>
                <svg class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2">
                    <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
                </svg>
            </button>

            <div class="hidden items-center gap-1 md:flex">
                <a class="@NavLinkClass("Index")" asp-controller="Home" asp-action="Index">Startsida</a>
                <a class="@NavLinkClass("Services")" asp-controller="Home" asp-action="Services">Tjänster</a>
                <a class="@NavLinkClass("About")" asp-controller="Home" asp-action="About">Om oss</a>
                <a class="@NavLinkClass("Contact")" asp-controller="Home" asp-action="Contact">Kontakt</a>
            </div>
        </nav>
        <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-4 pb-4 md:hidden">
            <div class="mx-auto flex max-w-7xl flex-col gap-2 pt-3">
                <a class="@NavLinkClass("Index")" asp-controller="Home" asp-action="Index">Startsida</a>
                <a class="@NavLinkClass("Services")" asp-controller="Home" asp-action="Services">Tjänster</a>
                <a class="@NavLinkClass("About")" asp-controller="Home" asp-action="About">Om oss</a>
                <a class="@NavLinkClass("Contact")" asp-controller="Home" asp-action="Contact">Kontakt</a>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="border-t border-slate-200 bg-slate-950 text-slate-200">
        <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3 lg:px-8">
            <div>
                <p class="text-lg font-bold text-white">EL Arne AB</p>
                <p class="mt-3 max-w-sm text-sm leading-6 text-slate-400">Trygga elinstallationer, smart service och
                    tydlig kommunikation för privatpersoner, BRF:er och mindre företag.</p>
                </div>
                <div>
                    <p class="font-semibold text-white">Kontakt</p>
                    <ul class="mt-3 space-y-2 text-sm text-slate-400">
                        <li><a class="hover:text-amber-300" href="tel:+4631123456">031-12 34 56</a></li>
                        <li><a class="hover:text-amber-300" href="mailto:info@elarne.se">info@elarne.se</a></li>
                        <li>Elektrikergatan 12, 411 21 Göteborg</li>
                    </ul>
                </div>
                <div>
                    <p class="font-semibold text-white">Öppettider</p>
                    <p class="mt-3 text-sm leading-6 text-slate-400">Måndag-fredag 07.00-16.00<br />Akuta ärenden hanteras
                        enligt överenskommelse.</p>
                    </div>
                </div>
                <div class="border-t border-slate-800 px-4 py-5 text-center text-xs text-slate-500">
                    &copy; 2026 EL Arne AB. Alla rättigheter förbehållna.
                </div>
            </footer>

            <script src="~/js/site.js" asp-append-version="true"></script>
            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>
