@model ServiceCardViewModel

<article class="rounded border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
    <div class="grid h-12 w-12 place-items-center rounded bg-amber-100 text-2xl" aria-hidden="true">@Model.Icon</div>
    <h3 class="mt-5 text-xl font-bold text-slate-950">@Model.Title</h3>
    <p class="mt-3 leading-7 text-slate-600">@Model.Description</p>
</article>
