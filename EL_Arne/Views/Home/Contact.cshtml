@{
    ViewData["Title"] = "Kontakt";
}

<section class="bg-white py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
        <div>
            <p class="text-sm font-bold uppercase tracking-[0.18em] text-amber-600">Kontakt</p>
            <h1 class="mt-3 text-4xl font-black text-slate-950 sm:text-5xl">Berätta vad du behöver hjälp med.</h1>
            <p class="mt-5 text-lg leading-8 text-slate-600">Ring oss för snabb dialog eller skicka ett mejl med bilder och kort beskrivning. Vi återkommer normalt inom en arbetsdag.</p>

            <div class="mt-8 space-y-4">
                <a class="flex rounded border border-slate-200 bg-slate-50 p-5 transition hover:border-amber-300 hover:bg-amber-50" href="tel:+4631123456">
                    <span class="mr-4 text-2xl" aria-hidden="true">☎</span>
                    <span>
                        <span class="block text-sm font-bold uppercase tracking-[0.12em] text-slate-500">Telefon</span>
                        <span class="mt-1 block text-xl font-black text-slate-950">031-12 34 56</span>
                    </span>
                </a>
                <a class="flex rounded border border-slate-200 bg-slate-50 p-5 transition hover:border-amber-300 hover:bg-amber-50" href="mailto:info@elarne.se">
                    <span class="mr-4 text-2xl" aria-hidden="true">✉</span>
                    <span>
                        <span class="block text-sm font-bold uppercase tracking-[0.12em] text-slate-500">E-post</span>
                        <span class="mt-1 block text-xl font-black text-slate-950">info@elarne.se</span>
                    </span>
                </a>
            </div>
        </div>

        <form class="rounded border border-slate-200 bg-slate-50 p-6 shadow-sm" aria-label="Kontaktformulär utan backend">
            <div class="grid gap-5 sm:grid-cols-2">
                <label class="block">
                    <span class="text-sm font-semibold text-slate-700">Namn</span>
                    <input class="mt-2 w-full rounded border border-slate-300 bg-white px-3 py-3 outline-none transition focus:border-amber-500 focus:ring-2 focus:ring-amber-200" type="text" placeholder="Ditt namn" />
                </label>
                <label class="block">
                    <span class="text-sm font-semibold text-slate-700">Telefon</span>
                    <input class="mt-2 w-full rounded border border-slate-300 bg-white px-3 py-3 outline-none transition focus:border-amber-500 focus:ring-2 focus:ring-amber-200" type="tel" placeholder="070-123 45 67" />
                </label>
            </div>
            <label class="mt-5 block">
                <span class="text-sm font-semibold text-slate-700">E-post</span>
                <input class="mt-2 w-full rounded border border-slate-300 bg-white px-3 py-3 outline-none transition focus:border-amber-500 focus:ring-2 focus:ring-amber-200" type="email" placeholder="namn@example.se" />
            </label>
            <label class="mt-5 block">
                <span class="text-sm font-semibold text-slate-700">Meddelande</span>
                <textarea class="mt-2 min-h-36 w-full rounded border border-slate-300 bg-white px-3 py-3 outline-none transition focus:border-amber-500 focus:ring-2 focus:ring-amber-200" placeholder="Beskriv arbetet kort. Formuläret är en visuell platshållare."></textarea>
            </label>
            <button class="mt-6 w-full rounded bg-slate-950 px-5 py-3 text-sm font-bold text-white opacity-80" type="button">Skicka förfrågan</button>
            <p class="mt-3 text-sm text-slate-500">Formuläret är inte kopplat till backend. Använd telefon eller e-post för riktig kontakt.</p>
        </form>
    </div>
</section>
